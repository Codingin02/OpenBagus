{
  "version": "openbagus_delivery_example_v1",
  "purpose": "Template for local delivery configuration. Keep real secrets in environment variables only.",
  "email_smtp": {
    "host_env": "OPENBAGUS_EMAIL_SMTP_HOST",
    "port_env": "OPENBAGUS_EMAIL_SMTP_PORT",
    "username_env": "OPENBAGUS_EMAIL_SMTP_USERNAME",
    "password_env": "OPENBAGUS_EMAIL_SMTP_PASSWORD",
    "from_env": "OPENBAGUS_EMAIL_FROM",
    "to_env": "OPENBAGUS_EMAIL_TO",
    "security_env": "OPENBAGUS_EMAIL_SECURITY",
    "live_enabled_env": "OPENBAGUS_EMAIL_LIVE_ENABLED"
  },
  "ntfy": {
    "server_env": "OPENBAGUS_NTFY_SERVER",
    "topic_env": "OPENBAGUS_NTFY_TOPIC",
    "token_env_optional": "OPENBAGUS_NTFY_TOKEN",
    "priority_env_optional": "OPENBAGUS_NTFY_PRIORITY"
  },
  "web_pwa": {
    "host_env_optional": "OPENBAGUS_WEB_DASHBOARD_HOST",
    "port_env_optional": "OPENBAGUS_WEB_DASHBOARD_PORT",
    "default_host": "127.0.0.1",
    "default_port": 8787
  },
  "llm_jury": {
    "enabled_env": "OPENROUTER_API_KEY",
    "decision_core": "Python Quant Engine",
    "allowed_role": "critic_summarizer_report_editor_only"
  },
  "google_sheets": {
    "enabled_env": "OPENBAGUS_GOOGLE_SHEETS_ENABLED",
    "spreadsheet_id_env": "OPENBAGUS_GOOGLE_SHEETS_SPREADSHEET_ID",
    "service_account_path_env": "OPENBAGUS_GOOGLE_SERVICE_ACCOUNT_JSON_PATH",
    "local_fallback": "reports/runtime/sheets/"
  },
  "safety": {
    "external_delivery_default": "OFF",
    "manual_trigger": "OpenBagus",
    "do_not_store_real_password_token_or_private_topic_here": true
  }
}
