# OpenBagus Environment Configuration Template
# Copy this file to .env or config/openbagus_runtime_local.env
# All settings are OPTIONAL. The core crypto CLI works without any keys.

# Optional official US macro provider (Federal Reserve Economic Data)
# Free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional LLM critic and summarizer
OPENBAGUS_LLM_JURY_ENABLED=false
OPENROUTER_API_KEY=

# Optional provider-neutral SMTP email delivery
OPENBAGUS_EMAIL_SMTP_HOST=
OPENBAGUS_EMAIL_SMTP_PORT=587
OPENBAGUS_EMAIL_SECURITY=starttls
OPENBAGUS_EMAIL_SMTP_USERNAME=
OPENBAGUS_EMAIL_SMTP_PASSWORD=
OPENBAGUS_EMAIL_FROM=
OPENBAGUS_EMAIL_TO=
OPENBAGUS_EMAIL_LIVE_ENABLED=false
